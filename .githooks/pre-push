#!/usr/bin/env bash
# Before a push: secret check and file size check on the files that each new commit adds or changes.
# Commits made by cherry-pick, rebase or merge, or with --no-verify, did not pass the pre-commit hook, and CI runs only
# after the push, when a key in a public repository is already exposed. A key that a later commit removes stays in the
# history, so every new commit is checked, not only the last one. Enable with: bash scripts/setup.sh
# Any error stops the push (set -e): a check that cannot run must not let the commits through.
set -euo pipefail
remote="$1"
root="$(git rev-parse --show-toplevel)"
PYTHON="$(bash "$root/scripts/find-python.sh")"
# the exports contain only committed files, so no folder is skipped (scripts/check_secrets.py)
export PYTHONDONTWRITEBYTECODE=1 CHECK_EXPORT=1
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
cat > "$work/refs"
fail=0
while read -r _local_ref local_sha _remote_ref remote_sha <&3; do
    if [[ "$local_sha" =~ ^0+$ ]]; then continue; fi # a branch is deleted
    # new commits: not yet on any branch of this remote that we know of
    exclude=(--remotes="$remote")
    if [[ ! "$remote_sha" =~ ^0+$ ]] && git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
        exclude+=("$remote_sha")
    fi
    git rev-list "$local_sha" --not "${exclude[@]}" > "$work/commits"
    while read -r commit <&4; do
        # files added or changed by the commit (for a merge: compared with its first parent)
        if git rev-parse -q --verify "$commit^" > /dev/null; then
            git diff-tree -r -z --name-only --no-renames --diff-filter=d "$commit^" "$commit" > "$work/files"
        else
            git ls-tree -r -z --name-only "$commit" > "$work/files"
        fi
        if [[ ! -s "$work/files" ]]; then continue; fi
        export="$work/export"
        GIT_INDEX_FILE="$work/index" git read-tree "$commit"
        GIT_INDEX_FILE="$work/index" git checkout-index -z --stdin --prefix="$export/" < "$work/files"
        if ! "$PYTHON" "$root/scripts/check_secrets.py" "$export" ||
            ! "$PYTHON" "$root/scripts/check_file_size.py" "$export"; then
            echo "  in commit $(git log -1 --format='%h %s' "$commit")" >&2
            fail=1
        fi
        rm -rf "$export"
    done 4< "$work/commits"
done 3< "$work/refs"
if ((fail)); then
    echo "Push stopped. Rewrite the commits above so that none of them contains the file (docs/key-management.md)." >&2
fi
exit "$fail"
